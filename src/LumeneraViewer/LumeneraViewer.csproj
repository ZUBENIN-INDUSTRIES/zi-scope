<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AssemblyName>ZI-scope</AssemblyName>
    <Product>ZI-scope</Product>
    <AssemblyTitle>ZI-scope</AssemblyTitle>
    <Title>ZI-scope</Title>
    <Version>0.1.0-alpha</Version>
    <Company>ZUBENIN INDUSTRIES</Company>
    <Description>ZI-scope — программа для микроскопных камер Lumenera (экспериментальная альфа)</Description>
    <RootNamespace>LumeneraViewer</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\ZI-scope.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LumeneraViewer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ZI-scope.ico" />
    <Resource Include="Assets\ZI-scope-256.png" />
  </ItemGroup>

  <!-- Комплектный установщик драйверов (таск 03): installer\infinity*.exe → Drivers\ рядом с exe.
       Шаблон: если установщика нет, сборка не падает, просто нечего копировать.
       С -p:EmbedDrivers=true (publish.ps1) установщик вшивается в сам exe и в Drivers\ не копируется:
       DriverService распакует его перед установкой (см. DriverService.EmbeddedPrefix). -->
  <ItemGroup Condition="'$(EmbedDrivers)' == 'true'">
    <EmbeddedResource Include="..\..\installer\infinity*.exe" LogicalName="ZI-scope.Drivers.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(EmbedDrivers)' != 'true'">
    <None Include="..\..\installer\infinity*.exe" LinkBase="Drivers"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
