<ui:FluentWindow x:Class="LumeneraViewer.Views.CalibrationFromImageWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Калибровка по снимку"
                 Width="1180" Height="760" MinWidth="820" MinHeight="520"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 Background="{StaticResource Zs.Window}"
                 Foreground="{StaticResource Zs.Text}"
                 FontFamily="{StaticResource Zs.Font}"
                 FontSize="13">
    <!-- DataContext — CalibrationFromImageViewModel -->
    <Grid Background="{StaticResource Zs.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Height="40" ShowMinimize="False">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ImageSearch24" FontSize="16" Foreground="{StaticResource Zs.TextSecondary}" Margin="0,0,8,0"/>
                    <TextBlock Text="Калибровка по снимку" Foreground="{StaticResource Zs.Text}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FileName, StringFormat='  ·  {0}'}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Картинка «вписать» и найденная линия поверх -->
            <Border Background="{StaticResource Zs.Input}" BorderBrush="{StaticResource Zs.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Zs.RadiusPanel}" ClipToBounds="True">
                <Grid>
                    <Viewbox x:Name="Fit" Stretch="Uniform" Margin="8">
                        <Grid x:Name="Surface">
                            <Image x:Name="Picture" Source="{Binding Image}" Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Canvas x:Name="Marks" Background="Transparent" Cursor="Cross"
                                    MouseLeftButtonDown="OnMarksDown" MouseMove="OnMarksMove" MouseLeftButtonUp="OnMarksUp"/>
                        </Grid>
                    </Viewbox>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="12,6" IsHitTestVisible="False"
                            Background="{StaticResource Zs.Raised}" BorderBrush="{StaticResource Zs.Border}" BorderThickness="1" CornerRadius="14">
                        <TextBlock Text="{Binding HintText}" Foreground="{StaticResource Zs.Text}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Панель справа -->
            <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource ZsGroup}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Распознано" Style="{StaticResource ZsSectionLabel}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding DetectionText}" Foreground="{StaticResource Zs.Text}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding OcrText}" ToolTip="{Binding OcrRawText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <ui:Button Content="Провести линию заново" Appearance="Secondary" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                       Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding RedrawCommand}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ZsGroup}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Длина линии" Style="{StaticResource ZsSectionLabel}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="ValueBox" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="например 100"/>
                                <ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{Binding UnitNames}" SelectedIndex="{Binding UnitIndex}"/>
                            </Grid>
                            <TextBlock Text="Увеличение" Style="{StaticResource ZsSectionLabel}" Margin="0,12,0,6"/>
                            <ComboBox ItemsSource="{Binding Magnifications}" SelectedItem="{Binding SelectedMagnification}" ItemStringFormat="×{0}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ZsGroup}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Итог" Style="{StaticResource ZsSectionLabel}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding ResultText}" Foreground="{StaticResource Zs.Text}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding WidthWarning}" Foreground="{StaticResource Zs.Warning}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                                       Visibility="{Binding HasWidthWarning, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <ui:Button Content="{Binding SaveText}" Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                               Command="{Binding SaveCommand}" IsDefault="True"/>
                    <ui:Button Content="Отмена" Appearance="Secondary" HorizontalAlignment="Stretch"
                               Command="{Binding CancelCommand}" IsCancel="True"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
