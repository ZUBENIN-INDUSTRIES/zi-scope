<UserControl x:Class="LumeneraViewer.Views.MeasurePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <!-- DataContext — MeasurePanelViewModel -->
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Zs.Text}"/>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="0,10,0,0">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ToggleButton IsChecked="{Binding IsRulerActive}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          AutomationProperties.Name="Линейка"
                          ToolTip="Клик — начало, клик — конец отрезка. Shift — строго по горизонтали/вертикали. Esc — выход.">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Ruler24" Margin="0,0,6,0"/>
                    <TextBlock Text="Линейка"/>
                </StackPanel>
            </ToggleButton>
            <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Очистить всё" Icon="{ui:SymbolIcon Delete24}"
                       Command="{Binding ClearAllCommand}" IsEnabled="{Binding HasItems}"/>
        </Grid>

        <TextBlock Text="Включите «Линейку» и кликните по двум точкам на изображении."
                   Style="{StaticResource MutedText}" Margin="0,0,0,8"
                   Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

        <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,8"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="6" Padding="10,2,2,2" Margin="0,0,0,4" Background="{StaticResource Zs.Raised}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number, StringFormat=#{0}}" Foreground="{StaticResource Zs.TextSecondary}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Dismiss16}" Padding="6" Appearance="Transparent" ToolTip="Удалить"
                                       Command="{Binding DataContext.RemoveCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Перекрестие" Style="{StaticResource Label}"/>
            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Crosshair}"/>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Сетка, шаг" Style="{StaticResource Label}"/>
            <ui:TextBox Grid.Column="1" Text="{Binding GridStepText, UpdateSourceTrigger=PropertyChanged, Delay=400}" ToolTip="Шаг сетки"/>
            <TextBlock Grid.Column="2" Text="{Binding GridStepUnit}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="6,0,10,0"/>
            <ui:ToggleSwitch Grid.Column="3" IsChecked="{Binding Grid}"/>
        </Grid>
    </StackPanel>
</UserControl>
