<UserControl x:Class="LumeneraViewer.Views.MagnificationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- DataContext снаружи — MainViewModel; внутри Root — MagnificationBarViewModel (создаёт код окна). -->
    <StackPanel x:Name="Root" Orientation="Horizontal">
        <TextBlock Text="Увеличение" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Border Style="{StaticResource ZsSegmentBar}">
            <StackPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource ZsSegment}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         GroupName="Magnification" ToolTip="Калибровка, длина плашки и цвет этого увеличения. Правый клик — удалить">
                                <RadioButton.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding RemoveHeader}" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanRemove}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </RadioButton.ContextMenu>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button Icon="{ui:SymbolIcon Add24}" Command="{Binding AddCommand}" Appearance="Transparent" Padding="6,3"
                           Margin="2,0,0,0" Focusable="False" ToolTip="Добавить увеличение"/>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding ShowNotCalibrated, Converter={StaticResource BoolToVis}}"
                    ToolTip="Для этого увеличения нет калибровки мкм/px — плашка масштаба не рисуется. Вкладка «Масштаб» → «Калибровать»">
            <ui:SymbolIcon Symbol="Warning24" FontSize="14" Foreground="{StaticResource Zs.Warning}" Margin="0,0,4,0"/>
            <TextBlock Text="не откалиброван" Foreground="{StaticResource Zs.Warning}" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</UserControl>
