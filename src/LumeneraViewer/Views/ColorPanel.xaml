<UserControl x:Class="LumeneraViewer.Views.ColorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:fx="clr-namespace:LumeneraViewer.UI.Effects"
             xmlns:c="clr-namespace:LumeneraViewer.UI.Controls">
    <!-- DataContext — ColorPanelViewModel -->
    <UserControl.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Zs.Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Zs.Border}"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <c:LabeledSlider Label="Яркость" Value="{Binding Brightness}" Minimum="-100" Maximum="100" DefaultValue="0" Format="+0;−0;0"/>
        <c:LabeledSlider Label="Контраст" Value="{Binding Contrast}" Minimum="-100" Maximum="100" DefaultValue="0" Format="+0;−0;0"/>
        <c:LabeledSlider Label="Гамма" Value="{Binding Gamma}" Minimum="0.2" Maximum="3" DefaultValue="1" Step="0.01" Format="0.00"/>
        <c:LabeledSlider Label="Насыщенность" Value="{Binding Saturation}" Minimum="0" Maximum="200" DefaultValue="100" Format="0" Suffix=" %"/>

        <Border Style="{StaticResource Divider}"/>

        <!-- Баланс белого -->
        <Grid Margin="0,0,0,4">
            <TextBlock Text="Баланс белого" Style="{StaticResource SectionLabel}"/>
            <ui:Button HorizontalAlignment="Right" Padding="10,3" FontSize="12" Command="{Binding AutoWhiteBalanceCommand}"
                       ToolTip="Серый мир по центральной области последнего кадра">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Wand24" FontSize="13" Margin="0,0,5,0"/>
                    <TextBlock Text="Авто-ББ"/>
                </StackPanel>
            </ui:Button>
        </Grid>
        <c:LabeledSlider Label="Температура" Value="{Binding Temperature}" Minimum="-100" Maximum="100" DefaultValue="0" Format="+0;−0;0"/>
        <c:LabeledSlider Label="Оттенок" Value="{Binding Tint}" Minimum="-100" Maximum="100" DefaultValue="0" Format="+0;−0;0"/>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:ToggleSwitch Content="Ч/Б" IsChecked="{Binding Grayscale}" ToolTip="Оттенки серого (яркость Rec.709)"/>
            <ui:ToggleSwitch Grid.Column="1" Content="Негатив" IsChecked="{Binding Negative}" ToolTip="Инверсия — для тёмного поля и флуоресценции"/>
        </Grid>

        <Border Style="{StaticResource Divider}"/>

        <ui:Button HorizontalAlignment="Stretch" Command="{Binding ResetAllCommand}" Margin="0,0,0,4"
                   ToolTip="Вернуть всю коррекцию текущего увеличения к значениям по умолчанию">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ArrowReset24" FontSize="14" Margin="0,0,6,0"/>
                <TextBlock Text="Сбросить всё"/>
            </StackPanel>
        </ui:Button>

        <Border Style="{StaticResource Divider}"/>

        <!-- Профили цвета (история 26) -->
        <TextBlock Text="Профили цвета" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                 MaxHeight="160" FontSize="12.5" ToolTip="Двойной щелчок — применить к текущему увеличению"
                 MouseDoubleClick="Profiles_DoubleClick"/>
        <TextBlock Text="Пока нет профилей — сохраните текущие настройки цвета." Style="{StaticResource MutedText}" Margin="0,6,0,0"
                   TextWrapping="Wrap" Visibility="{Binding HasNoProfiles, Converter={StaticResource BoolToVis}}"/>
        <CheckBox Content="С экспозицией и усилением" IsChecked="{Binding IncludeExposure}" Margin="0,8,0,0"
                  ToolTip="Сохранять в новый профиль также экспозицию и усиление камеры"/>
        <WrapPanel Margin="0,8,0,0">
            <ui:Button Content="Применить" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Margin="0,0,6,6"
                       Command="{Binding ApplyProfileCommand}" ToolTip="Применить профиль к текущему увеличению"/>
            <ui:Button Content="Сохранить как…" Icon="{ui:SymbolIcon Save24}" Margin="0,0,6,6" Command="{Binding SaveProfileCommand}"/>
            <ui:Button Padding="9" Icon="{ui:SymbolIcon Rename24}" Margin="0,0,6,6" Command="{Binding RenameProfileCommand}" ToolTip="Переименовать"/>
            <ui:Button Padding="9" Icon="{ui:SymbolIcon Delete24}" Margin="0,0,6,6" Command="{Binding DeleteProfileCommand}" ToolTip="Удалить"/>
            <ui:Button Padding="9" Icon="{ui:SymbolIcon ArrowExportUp24}" Margin="0,0,6,6" Command="{Binding ExportProfileCommand}" ToolTip="Экспорт в файл .zcolor…"/>
            <ui:Button Padding="9" Icon="{ui:SymbolIcon ArrowImport24}" Margin="0,0,6,6" Command="{Binding ImportProfileCommand}" ToolTip="Импорт из файла .zcolor…"/>
        </WrapPanel>
    </StackPanel>
</UserControl>
