<UserControl x:Class="LumeneraViewer.Views.ColorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:fx="clr-namespace:LumeneraViewer.UI.Effects"
             xmlns:c="clr-namespace:LumeneraViewer.UI.Controls">
    <!-- DataContext — ColorPanelViewModel -->
    <UserControl.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Zs.Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Zs.Border}"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <c:LabeledSlider Label="Яркость" Value="{Binding Brightness}" Minimum="-100" Maximum="100" DefaultValue="0" Format="+0;−0;0"/>
        <c:LabeledSlider Label="Контраст" Value="{Binding Contrast}" Minimum="-100" Maximum="100" DefaultValue="0" Format="+0;−0;0"/>
        <c:LabeledSlider Label="Гамма" Value="{Binding Gamma}" Minimum="0.2" Maximum="3" DefaultValue="1" Step="0.01" Format="0.00"/>
        <c:LabeledSlider Label="Насыщенность" Value="{Binding Saturation}" Minimum="0" Maximum="200" DefaultValue="100" Format="0" Suffix=" %"/>

        <Border Style="{StaticResource Divider}"/>

        <!-- Баланс белого -->
        <Grid Margin="0,0,0,4">
            <TextBlock Text="Баланс белого" Style="{StaticResource SectionLabel}"/>
            <ui:Button HorizontalAlignment="Right" Padding="10,3" FontSize="12" Command="{Binding AutoWhiteBalanceCommand}"
                       ToolTip="Серый мир по центральной области последнего кадра">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Wand24" FontSize="13" Margin="0,0,5,0"/>
                    <TextBlock Text="Авто-ББ"/>
                </StackPanel>
            </ui:Button>
        </Grid>
        <c:LabeledSlider Label="Температура" Value="{Binding Temperature}" Minimum="-100" Maximum="100" DefaultValue="0" Format="+0;−0;0"/>
        <c:LabeledSlider Label="Оттенок" Value="{Binding Tint}" Minimum="-100" Maximum="100" DefaultValue="0" Format="+0;−0;0"/>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:ToggleSwitch Content="Ч/Б" IsChecked="{Binding Grayscale}" ToolTip="Оттенки серого (яркость Rec.709)"/>
            <ui:ToggleSwitch Grid.Column="1" Content="Негатив" IsChecked="{Binding Negative}" ToolTip="Инверсия — для тёмного поля и флуоресценции"/>
        </Grid>

        <Border Style="{StaticResource Divider}"/>

        <!-- Пресеты -->
        <TextBlock Text="Пресеты" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"
                      FontSize="12.5" ToolTip="Выбор сразу применяет пресет"/>
            <ui:Button Grid.Column="1" Margin="6,0,0,0" Padding="9" Icon="{ui:SymbolIcon ArrowSync24}"
                       Command="{Binding ApplyPresetCommand}" ToolTip="Применить ещё раз"/>
            <ui:Button Grid.Column="2" Margin="6,0,0,0" Padding="9" Icon="{ui:SymbolIcon Delete24}"
                       Command="{Binding DeletePresetCommand}" ToolTip="Удалить пресет"/>
        </Grid>
        <TextBlock Text="Пока нет пресетов — сохраните текущие настройки." Style="{StaticResource MutedText}" Margin="0,6,0,0"
                   Visibility="{Binding HasNoPresets, Converter={StaticResource BoolToVis}}"/>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:Button HorizontalAlignment="Stretch" Command="{Binding SavePresetCommand}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Save24" FontSize="14" Margin="0,0,6,0"/>
                    <TextBlock Text="Сохранить как…"/>
                </StackPanel>
            </ui:Button>
            <ui:Button Grid.Column="2" HorizontalAlignment="Stretch" Command="{Binding ResetAllCommand}"
                       ToolTip="Вернуть всю коррекцию к значениям по умолчанию">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowReset24" FontSize="14" Margin="0,0,6,0"/>
                    <TextBlock Text="Сбросить всё"/>
                </StackPanel>
            </ui:Button>
        </Grid>
    </StackPanel>
</UserControl>
