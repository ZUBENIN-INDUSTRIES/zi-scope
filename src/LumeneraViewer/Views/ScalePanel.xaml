<UserControl x:Class="LumeneraViewer.Views.ScalePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:fx="clr-namespace:LumeneraViewer.UI.Effects"
             xmlns:v="clr-namespace:LumeneraViewer.Views">
    <!-- DataContext — ScalePanelViewModel -->
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Zs.Text}"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="0,10,0,0">
        <!-- Старые калибровки объективов: перенос в увеличения (история 10) -->
        <Border Style="{StaticResource ZsGroup}" Margin="0,0,0,10" BorderBrush="{StaticResource Zs.Warning}" BorderThickness="1"
                Visibility="{Binding HasLegacyCalibrations, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <ui:SymbolIcon Symbol="Info24" Foreground="{StaticResource Zs.Warning}" Margin="0,0,6,0"/>
                    <TextBlock Text="Старые калибровки объективов" FontWeight="SemiBold" Foreground="{StaticResource Zs.Text}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding LegacySummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding LegacyCalibrations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Zs.Text}"/>
                                    <TextBlock Text="{Binding MicronsPerPixel, StringFormat={}{0:0.#####}&#x00A0;мкм/px}" TextWrapping="NoWrap" Style="{StaticResource MutedText}" FontSize="11.5"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" MinWidth="86" Margin="6,0" ItemsSource="{Binding Magnifications}"
                                          SelectedItem="{Binding TargetMagnification}" ItemStringFormat="×{0}" ToolTip="Какому увеличению соответствует"/>
                                <ui:Button Grid.Column="2" Content="Перенести" Appearance="Secondary"
                                           Command="{Binding DataContext.TransferLegacyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button Content="Скрыть" Appearance="Transparent" HorizontalAlignment="Right" Command="{Binding DismissLegacyCommand}"
                           ToolTip="Больше не показывать это уведомление"/>
            </StackPanel>
        </Border>

        <!-- Текущее увеличение -->
        <TextBlock Style="{StaticResource ZsSectionLabel}" Margin="0,0,0,6">
            <Run Text="Увеличение"/> <Run Text="{Binding MagnificationText, Mode=OneWay}"/>
        </TextBlock>

        <!-- Калибровка -->
        <Border Style="{StaticResource ZsGroup}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Калибровка" Style="{StaticResource MutedText}" FontSize="11.5"/>
                    <TextBlock Text="{Binding CalibrationText}" FontWeight="SemiBold" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Zs.Text}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCalibrated}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource Zs.Warning}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding CalibrateCommand}"
                           Icon="{ui:SymbolIcon Ruler24}" ToolTip="Провести линию по объект-микрометру и ввести её длину">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Content" Value="Калибровать"/>
                            <Setter Property="Appearance" Value="Secondary"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCalibrating}" Value="True">
                                    <Setter Property="Content" Value="Отмена"/>
                                    <Setter Property="Appearance" Value="Secondary"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                           Content="Калибровать по снимку…" Appearance="Secondary" Icon="{ui:SymbolIcon ImageSearch24}"
                           Command="{Binding CalibrateFromImageCommand}"
                           ToolTip="Выбрать снимок с этой камеры с нанесённой масштабной линией — линия и число найдутся сами"/>
                <ui:Button Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                           Content="Ввести мкм/px…" Appearance="Secondary" Icon="{ui:SymbolIcon NumberSymbol24}"
                           Command="{Binding EnterMicronsPerPixelCommand}" AutomationProperties.Name="Ввести мкм/px"
                           ToolTip="Задать размер пикселя числом, если он уже известен (из паспорта объектива или другой программы)"/>
            </Grid>
        </Border>

        <!-- Размер пикселя по увеличениям (G05) -->
        <v:PixelSizeTable Margin="0,0,0,10"/>

        <!-- Плашка -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Плашка масштаба" Style="{StaticResource Label}" FontWeight="SemiBold"/>
            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ScaleBarEnabled}" IsEnabled="{Binding IsCalibrated}"/>
        </Grid>
        <TextBlock Text="Без калибровки плашка выключена: пиксели не выдаются за микроны. Откалибруйте это увеличение кнопкой «Калибровать»."
                   Style="{StaticResource MutedText}" Margin="0,-4,0,8"
                   Visibility="{Binding IsCalibrated, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

        <StackPanel IsEnabled="{Binding IsCalibrated}">
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Corners}" SelectedIndex="{Binding CornerIndex}" ToolTip="Угол"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding ColorNames}" SelectedIndex="{Binding ColorIndex}"
                          ToolTip="Общий цвет: сетка, перекрестие, измерения и части плашки, для которых цвет не выбран"/>
            </Grid>

            <!-- Цвета частей плашки: квадратик цвета + название -->
            <Grid Style="{StaticResource Row}">
                <Grid.Resources>
                    <DataTemplate x:Key="ColorItem">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}" BorderBrush="{StaticResource Zs.Border}"
                                    BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Текст" Style="{StaticResource Label}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding BarColorChoices}" SelectedIndex="{Binding TextColorIndex}"
                          ItemTemplate="{StaticResource ColorItem}" AutomationProperties.Name="Цвет текста плашки"/>
                <TextBlock Grid.Row="2" Text="Линейка" Style="{StaticResource Label}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding BarColorChoices}" SelectedIndex="{Binding BarColorIndex}"
                          ItemTemplate="{StaticResource ColorItem}" AutomationProperties.Name="Цвет линейки плашки"/>
                <TextBlock Grid.Row="4" Text="Подложка" Style="{StaticResource Label}"/>
                <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding BarColorChoices}" SelectedIndex="{Binding BackgroundColorIndex}"
                          ItemTemplate="{StaticResource ColorItem}" IsEnabled="{Binding Background}" AutomationProperties.Name="Цвет подложки плашки"/>
            </Grid>
            <Grid Style="{StaticResource Row}" IsEnabled="{Binding Background}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Плотность" Style="{StaticResource Label}" ToolTip="Непрозрачность подложки"/>
                <Slider Grid.Column="1" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5"
                        Value="{Binding BackgroundOpacityPercent}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding BackgroundOpacityPercent, StringFormat={}{0}&#x00A0;%}" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Шрифт" Style="{StaticResource Label}" ToolTip="Arial; размер — для кадра шириной 1600 px, на больших кадрах пропорционально крупнее"/>
                <Slider Grid.Column="1" Minimum="10" Maximum="48" SmallChange="1" LargeChange="4" IsSnapToTickEnabled="True" TickFrequency="1"
                        Value="{Binding FontSize}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding FontSize}" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Толщина" Style="{StaticResource Label}"/>
                <Slider Grid.Column="1" Minimum="2" Maximum="12" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1"
                        Value="{Binding Thickness}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Thickness}" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="92"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Длина" Style="{StaticResource Label}"/>
                <CheckBox Grid.Column="1" Content="Авто" IsChecked="{Binding AutoLength}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,6,0"/>
                <ui:TextBox Grid.Column="2" Text="{Binding ManualLengthText, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                            PlaceholderText="500" IsEnabled="{Binding IsManualLength}" ToolTip="Длина плашки вручную, в выбранных единицах"
                            AutomationProperties.Name="Длина плашки"/>
                <ComboBox Grid.Column="3" Margin="6,0,0,0" ItemsSource="{Binding UnitNames}" SelectedIndex="{Binding UnitIndex}" ToolTip="Единицы"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox Content="Подложка" IsChecked="{Binding Background}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,16,0"/>
                <CheckBox Content="Жирный" IsChecked="{Binding Bold}" VerticalAlignment="Center" MinWidth="0"/>
            </StackPanel>
            <ui:Button Content="Вернуть в угол" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetPositionCommand}" HorizontalAlignment="Left"
                       IsEnabled="{Binding HasCustomPosition}" ToolTip="Плашку можно перетащить мышью; кнопка возвращает её в выбранный угол"/>
        </StackPanel>
    </StackPanel>
</UserControl>
