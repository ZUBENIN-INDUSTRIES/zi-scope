<UserControl x:Class="LumeneraViewer.Views.CameraPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:fx="clr-namespace:LumeneraViewer.UI.Effects"
             xmlns:c="clr-namespace:LumeneraViewer.UI.Controls">
    <!-- DataContext — CameraPanelViewModel -->
    <UserControl.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Zs.Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Zs.Border}"/>
            <Setter Property="Margin" Value="0,12,0,10"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding PropertiesHint}" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                   Visibility="{Binding HasPropertiesHint, Converter={StaticResource BoolToVis}}"/>

        <!-- Экспозиция: логарифмический слайдер + поле в мс -->
        <Grid IsEnabled="{Binding ExposureAvailable}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Экспозиция" FontSize="12.5" Foreground="{StaticResource Zs.Text}" VerticalAlignment="Center"/>
            <ui:NumberBox Grid.Column="1" Width="104" Padding="8,4" FontSize="12.5"
                          Value="{Binding ExposureMs, Mode=TwoWay}"
                          Minimum="{Binding ExposureMin}" Maximum="{Binding ExposureMax}"
                          MaxDecimalPlaces="2" SmallChange="1" LargeChange="10"
                          SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False"
                          ToolTip="Время экспозиции, мс. Enter — применить"/>
            <TextBlock Grid.Column="2" Text="мс" Margin="6,0,0,0" FontSize="12.5" Foreground="{StaticResource Zs.TextSecondary}" VerticalAlignment="Center"/>
        </Grid>
        <Slider Margin="0,4,0,4" IsEnabled="{Binding ExposureAvailable}"
                Minimum="{Binding ExposureLogMin}" Maximum="{Binding ExposureLogMax}"
                Value="{Binding ExposureLog, Mode=TwoWay}"
                SmallChange="0.02" LargeChange="0.1" IsMoveToPointEnabled="True"
                PreviewMouseLeftButtonDown="ExposureSlider_PreviewDown"
                ToolTip="Логарифмическая шкала. Двойной клик — значение камеры по умолчанию"/>

        <c:LabeledSlider Label="Усиление" Value="{Binding Gain}" IsEnabled="{Binding GainAvailable}"
                         Minimum="{Binding GainMin}" Maximum="{Binding GainMax}" DefaultValue="{Binding GainDefault}"
                         Step="0.1" Format="0.0" Suffix=" ×"/>

        <ui:Button Margin="0,6,0,0" HorizontalAlignment="Stretch" Command="{Binding RunAutoCommand}"
                   ToolTip="Подобрать экспозицию по средней яркости центра кадра">
            <StackPanel Orientation="Horizontal">
                <Grid Width="16" Height="16" Margin="0,0,8,0">
                    <ui:SymbolIcon Symbol="BrightnessHigh24" FontSize="16"
                                   Visibility="{Binding IsAutoRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16"
                                     Visibility="{Binding IsAutoRunning, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <TextBlock Text="{Binding AutoText}" VerticalAlignment="Center"/>
            </StackPanel>
        </ui:Button>

        <Border Style="{StaticResource Divider}"/>

        <!-- Гистограмма -->
        <Grid Margin="0,0,0,6">
            <TextBlock Text="Гистограмма" Style="{StaticResource SectionLabel}"/>
            <Border HorizontalAlignment="Right" CornerRadius="999" Padding="8,2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Zs.Raised}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverexposed}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Zs.Error}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="11.5" Foreground="{StaticResource Zs.Text}"
                           Text="{Binding ClippedPercent, StringFormat=Пересвет {0:0.0} %}"/>
            </Border>
        </Grid>
        <c:HistogramView Height="72" Histogram="{Binding Histogram}"/>

        <Border Style="{StaticResource Divider}"/>

        <!-- Фокус-ассистент -->
        <Grid>
            <TextBlock Text="Фокус-ассистент" Style="{StaticResource SectionLabel}"/>
            <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Padding="8,3" FontSize="12"
                       Command="{Binding ResetFocusMaxCommand}" ToolTip="Сбросить максимум за сессию">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowReset24" FontSize="13" Margin="0,0,5,0"/>
                    <TextBlock Text="Сбросить"/>
                </StackPanel>
            </ui:Button>
        </Grid>
        <Grid Margin="0,2,0,6">
            <StackPanel Orientation="Horizontal">
                <fx:CountUpText Value="{Binding Sharpness}" Format="0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Zs.Text}"/>
                <TextBlock Text="резкость" Margin="8,0,0,4" FontSize="12" Foreground="{StaticResource Zs.TextSecondary}" VerticalAlignment="Bottom"/>
            </StackPanel>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4" FontSize="12" Foreground="{StaticResource Zs.TextSecondary}"
                       Text="{Binding SharpnessPercent, StringFormat={}{0:0} % от максимума, TargetNullValue=—}"/>
        </Grid>
        <c:LevelBar Height="8" Margin="0,0,0,4" Value="{Binding SharpnessLevel}" Marker="{Binding SharpnessMarker}"
                    ToolTip="Полоса — текущая резкость; светлая отметка — максимум за сессию"/>

        <c:LabeledSlider Margin="0,10,0,0" Label="Фокус (демо)" Value="{Binding DemoFocus}"
                         Minimum="0" Maximum="1" DefaultValue="0.5" Step="0.01" Format="0.00"
                         Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
</UserControl>
