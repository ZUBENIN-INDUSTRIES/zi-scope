<UserControl x:Class="LumeneraViewer.Views.GalleryStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <!-- DataContext — GalleryViewModel. Лента последних снимков, новые слева. -->
    <Grid>
        <!-- Пустая лента -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="22" Foreground="{StaticResource Zs.TextDisabled}" Margin="0,0,10,0"/>
            <TextBlock Text="Снимков пока нет — нажмите Пробел" Style="{StaticResource MutedText}" VerticalAlignment="Center" FontSize="13"/>
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly"
                      PreviewMouseWheel="OnPreviewMouseWheel" x:Name="Scroller">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Width="104" Height="70" Margin="0,0,8,0" CornerRadius="6" ClipToBounds="True"
                                Background="{StaticResource Zs.Input}" BorderBrush="{StaticResource Zs.Border}" BorderThickness="1" Cursor="Hand"
                                ToolTip="{Binding FileName}"
                                MouseLeftButtonUp="OnItemClick" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="Shift" X="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Открыть" Click="OnOpen">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="Open24"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Показать в папке" Click="OnShowInFolder">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen24"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Удалить" Click="OnDelete">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <!-- Заглушка, пока миниатюра декодируется -->
                                <TextBlock Text="{Binding FileName}" Style="{StaticResource MutedText}" FontSize="10" Margin="6"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" TextAlignment="Center"/>
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <!-- Появление: короткий сдвиг слева и проявление (≤150 мс) -->
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="X" From="-8" To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Zs.TextDisabled}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
