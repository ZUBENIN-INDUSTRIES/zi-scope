<ui:FluentWindow x:Class="LumeneraViewer.Views.DeepColorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:c="clr-namespace:LumeneraViewer.UI.Controls"
                 Title="Глубокие настройки цвета"
                 Width="440" Height="820" MinWidth="380" MinHeight="420"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="Manual"
                 ShowInTaskbar="False"
                 Background="{StaticResource Zs.Window}"
                 Foreground="{StaticResource Zs.Text}"
                 FontFamily="{StaticResource Zs.Font}"
                 FontSize="13">
    <!-- DataContext — DeepColorViewModel -->
    <ui:FluentWindow.Resources>
        <!-- Заголовок раздела: название + «Сбросить раздел» -->
        <Style x:Key="ResetSectionButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Content" Value="Сбросить раздел"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Command" Value="{Binding DataContext.ResetSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Style>
        <Style x:Key="Section" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{StaticResource Zs.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Height="36" ShowMinimize="False" ShowMaximize="False">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ColorLine24" FontSize="15" Foreground="{StaticResource Zs.TextSecondary}" Margin="0,0,8,0"/>
                    <TextBlock Text="Глубокие настройки цвета" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Для какого увеличения + «Сбросить всё» -->
        <Grid Grid.Row="1" Margin="14,2,14,8">
            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center">
                <Run Text="Для увеличения ×"/><Run Text="{Binding CurrentMagnification, Mode=OneWay}"/>
            </TextBlock>
            <ui:Button HorizontalAlignment="Right" Padding="10,3" Command="{Binding ResetAllCommand}"
                       ToolTip="Вернуть все глубокие настройки текущего увеличения к нейтральным">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowReset24" FontSize="14" Margin="0,0,6,0"/>
                    <TextBlock Text="Сбросить всё"/>
                </StackPanel>
            </ui:Button>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,0,14,14">
            <StackPanel>

                <!-- RGB (история 23) -->
                <Expander Style="{StaticResource Section}">
                    <Expander.Header>
                        <Grid>
                            <TextBlock Text="RGB" Style="{StaticResource HeaderText}"/>
                            <ui:Button Style="{StaticResource ResetSectionButton}" CommandParameter="rgb"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                        <c:HistogramView Height="64" Histogram="{Binding Histogram}" Margin="0,0,0,8"/>
                        <c:LabeledSlider Label="Усиление R" Value="{Binding RedGain}" Minimum="0.5" Maximum="2" DefaultValue="1" Step="0.01" Format="0.00"/>
                        <c:LabeledSlider Label="Усиление G" Value="{Binding GreenGain}" Minimum="0.5" Maximum="2" DefaultValue="1" Step="0.01" Format="0.00"/>
                        <c:LabeledSlider Label="Усиление B" Value="{Binding BlueGain}" Minimum="0.5" Maximum="2" DefaultValue="1" Step="0.01" Format="0.00"/>
                        <Grid Margin="0,8,0,6">
                            <TextBlock Text="Уровни" Style="{StaticResource ZsSectionLabel}"/>
                            <Border Style="{StaticResource ZsSegmentBar}" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource ZsSegment}" GroupName="Levels" IsChecked="True" Content="Общий" Command="{Binding SetLevelsChannelCommand}" CommandParameter="0"/>
                                    <RadioButton Style="{StaticResource ZsSegment}" GroupName="Levels" Content="R" Command="{Binding SetLevelsChannelCommand}" CommandParameter="1"/>
                                    <RadioButton Style="{StaticResource ZsSegment}" GroupName="Levels" Content="G" Command="{Binding SetLevelsChannelCommand}" CommandParameter="2"/>
                                    <RadioButton Style="{StaticResource ZsSegment}" GroupName="Levels" Content="B" Command="{Binding SetLevelsChannelCommand}" CommandParameter="3"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <c:LabeledSlider Label="Точка чёрного" Value="{Binding LevelBlack}" Minimum="0" Maximum="100" DefaultValue="0"/>
                        <c:LabeledSlider Label="Точка белого" Value="{Binding LevelWhite}" Minimum="155" Maximum="255" DefaultValue="255"/>
                        <c:LabeledSlider Label="Гамма" Value="{Binding LevelGamma}" Minimum="0.2" Maximum="3" DefaultValue="1" Step="0.01" Format="0.00"/>
                    </StackPanel>
                </Expander>

                <!-- Тон (история 24) -->
                <Expander Style="{StaticResource Section}">
                    <Expander.Header>
                        <Grid>
                            <TextBlock Text="Тон" Style="{StaticResource HeaderText}"/>
                            <ui:Button Style="{StaticResource ResetSectionButton}" CommandParameter="tone"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                        <c:LabeledSlider Label="Экспонирование" Value="{Binding ExposureEv}" Minimum="-3" Maximum="3" DefaultValue="0" Step="0.05" Format="+0.00;−0.00;0.00" Suffix=" EV"/>
                        <c:LabeledSlider Label="Светлые" Value="{Binding Highlights}" Minimum="-100" Maximum="100" DefaultValue="0" Format="+0;−0;0"/>
                        <c:LabeledSlider Label="Тени" Value="{Binding Shadows}" Minimum="-100" Maximum="100" DefaultValue="0" Format="+0;−0;0"/>
                        <c:LabeledSlider Label="Белые" Value="{Binding Whites}" Minimum="-100" Maximum="100" DefaultValue="0" Format="+0;−0;0"/>
                        <c:LabeledSlider Label="Чёрные" Value="{Binding Blacks}" Minimum="-100" Maximum="100" DefaultValue="0" Format="+0;−0;0"/>
                    </StackPanel>
                </Expander>

                <!-- Тональная кривая -->
                <Expander Style="{StaticResource Section}">
                    <Expander.Header>
                        <Grid>
                            <TextBlock Text="Тональная кривая" Style="{StaticResource HeaderText}"/>
                            <ui:Button Style="{StaticResource ResetSectionButton}" CommandParameter="curve"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                        <Border Style="{StaticResource ZsSegmentBar}" HorizontalAlignment="Left" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource ZsSegment}" GroupName="Curve" IsChecked="True" Content="Общий" Command="{Binding SetCurveChannelCommand}" CommandParameter="0"/>
                                <RadioButton Style="{StaticResource ZsSegment}" GroupName="Curve" Content="R" Command="{Binding SetCurveChannelCommand}" CommandParameter="1"/>
                                <RadioButton Style="{StaticResource ZsSegment}" GroupName="Curve" Content="G" Command="{Binding SetCurveChannelCommand}" CommandParameter="2"/>
                                <RadioButton Style="{StaticResource ZsSegment}" GroupName="Curve" Content="B" Command="{Binding SetCurveChannelCommand}" CommandParameter="3"/>
                            </StackPanel>
                        </Border>
                        <c:ToneCurveEditor Height="260" Curve="{Binding Curve}" Histogram="{Binding Histogram}" Channel="{Binding CurveChannel}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Клик — точка (до 12), перетаскивание — сдвиг, двойной клик по точке — удалить."/>
                    </StackPanel>
                </Expander>

                <!-- Присутствие -->
                <Expander Style="{StaticResource Section}">
                    <Expander.Header>
                        <Grid>
                            <TextBlock Text="Присутствие" Style="{StaticResource HeaderText}"/>
                            <ui:Button Style="{StaticResource ResetSectionButton}" CommandParameter="presence"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                        <c:LabeledSlider Label="Чёткость" Value="{Binding Clarity}" Minimum="-100" Maximum="100" DefaultValue="0" Format="+0;−0;0"/>
                        <c:LabeledSlider Label="Красочность" Value="{Binding Vibrance}" Minimum="-100" Maximum="100" DefaultValue="0" Format="+0;−0;0"/>
                        <c:LabeledSlider Label="Удаление дымки" Value="{Binding Dehaze}" Minimum="-100" Maximum="100" DefaultValue="0" Format="+0;−0;0"/>
                    </StackPanel>
                </Expander>

                <!-- HSL: 8 цветов × оттенок / насыщенность / светлота -->
                <Expander Style="{StaticResource Section}">
                    <Expander.Header>
                        <Grid>
                            <TextBlock Text="HSL" Style="{StaticResource HeaderText}"/>
                            <ui:Button Style="{StaticResource ResetSectionButton}" CommandParameter="hsl"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                        <Border Style="{StaticResource ZsSegmentBar}" HorizontalAlignment="Left" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource ZsSegment}" GroupName="Hsl" IsChecked="True" Content="Оттенок" Command="{Binding SetHslModeCommand}" CommandParameter="0"/>
                                <RadioButton Style="{StaticResource ZsSegment}" GroupName="Hsl" Content="Насыщенность" Command="{Binding SetHslModeCommand}" CommandParameter="1"/>
                                <RadioButton Style="{StaticResource ZsSegment}" GroupName="Hsl" Content="Светлота" Command="{Binding SetHslModeCommand}" CommandParameter="2"/>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding HslRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                        <c:LabeledSlider Grid.Column="1" Label="{Binding Name}" Value="{Binding Value}"
                                                         Minimum="-100" Maximum="100" DefaultValue="0" Format="+0;−0;0">
                                            <!-- Трек и бегунок — цветом сектора -->
                                            <c:LabeledSlider.Resources>
                                                <SolidColorBrush x:Key="SliderTrackFill" Color="{Binding TrackBrush.Color}"/>
                                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{Binding TrackBrush.Color}"/>
                                                <SolidColorBrush x:Key="SliderThumbBackground" Color="{Binding Brush.Color}"/>
                                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{Binding Brush.Color}"/>
                                                <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{Binding Brush.Color}"/>
                                            </c:LabeledSlider.Resources>
                                        </c:LabeledSlider>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- Детали -->
                <Expander Style="{StaticResource Section}">
                    <Expander.Header>
                        <Grid>
                            <TextBlock Text="Детали" Style="{StaticResource HeaderText}"/>
                            <ui:Button Style="{StaticResource ResetSectionButton}" CommandParameter="details"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                        <c:LabeledSlider Label="Резкость: сила" Value="{Binding SharpenAmount}" Minimum="0" Maximum="150" DefaultValue="0"/>
                        <c:LabeledSlider Label="Резкость: радиус" Value="{Binding SharpenRadius}" Minimum="0.5" Maximum="3" DefaultValue="1" Step="0.1" Format="0.0" Suffix=" px"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
