<UserControl x:Class="LumeneraViewer.Views.SeriesMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <!-- DataContext — SeriesPanelViewModel. Карта шагов: группы → образцы → увеличения (виртуализирована). -->
    <Grid>
        <!-- Серии нет -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsDesigning, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon Symbol="Grid24" FontSize="20" Foreground="{StaticResource Zs.TextDisabled}" Margin="0,0,10,0"/>
            <TextBlock Text="Карта серии появится, когда начнётся серия (вкладка «Серия»)" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Текущий шаг (просьба переключить микроскоп — плашкой поверх превью) -->
            <Border Padding="10,4" Margin="0,0,10,0" CornerRadius="{StaticResource Zs.RadiusGroup}" Background="{StaticResource Zs.Raised}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTitle}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource Zs.Text}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <ListBox x:Name="Map" Grid.Column="1" ItemsSource="{Binding Steps}" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel x:Name="Cell" Margin="0,0,4,0">
                            <TextBlock x:Name="Head" Text="{Binding Header}" FontSize="10.5" Foreground="{StaticResource Zs.TextSecondary}" Height="14"
                                       Margin="0,0,0,1"/>
                            <Border x:Name="Tile" Width="60" Height="50" CornerRadius="{StaticResource Zs.RadiusControl}" BorderThickness="2" ClipToBounds="True"
                                    BorderBrush="{StaticResource Zs.Border}" Background="{StaticResource Zs.Raised}" ToolTip="{Binding Tooltip}"
                                    Cursor="Hand" Tag="{Binding DataContext, ElementName=Root}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.MakeCurrentCommand, ElementName=Root}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Сделать текущим" Command="{Binding MakeCurrentCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Переснять" Command="{Binding ReshootCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Пропустить" Command="{Binding SkipCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="Удалить снимки шага…" Command="{Binding DeleteStepCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality"/>
                                    <TextBlock x:Name="Mark" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"
                                               Foreground="{StaticResource Zs.TextDisabled}"/>
                                    <Border VerticalAlignment="Bottom" Background="{StaticResource Zs.Scrim}" Padding="3,0">
                                        <DockPanel>
                                            <TextBlock Text="{Binding MagText}" DockPanel.Dock="Right" FontSize="10" Foreground="{StaticResource Zs.Text}"/>
                                            <TextBlock Text="{Binding Title}" FontSize="10" Foreground="{StaticResource Zs.Text}"/>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsGroupStart}" Value="True">
                                <Setter TargetName="Cell" Property="Margin" Value="8,0,4,0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Done">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Zs.Success}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Zs.TextDisabled}"/>
                                <Setter TargetName="Mark" Property="Text" Value="пропуск"/>
                                <Setter TargetName="Mark" Property="FontSize" Value="10.5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Zs.Warning}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Zs.Accent}"/>
                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource Zs.AccentSelection}"/>
                                <Setter TargetName="Tile" Property="BorderThickness" Value="3"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
