<UserControl x:Class="LumeneraViewer.Views.SeriesMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- DataContext — SeriesPanelViewModel. Карта шагов серии; заглушка, наполняет таск 06. -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
        <ui:SymbolIcon Symbol="Grid24" FontSize="20" Foreground="{StaticResource Zs.TextDisabled}" Margin="0,0,10,0"/>
        <TextBlock Text="Карта серии появится, когда начнётся серия" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>
