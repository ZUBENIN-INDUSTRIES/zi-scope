<UserControl x:Class="LumeneraViewer.Views.CapturePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:fx="clr-namespace:LumeneraViewer.UI.Effects"
             xmlns:c="clr-namespace:LumeneraViewer.UI.Controls">
    <!-- DataContext — CapturePanelViewModel -->
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,4,0,6"/>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="0,10,0,0">
        <!-- Формат -->
        <TextBlock Text="Формат" Style="{StaticResource Section}"/>
        <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" DisplayMemberPath="Name"
                  Margin="0,0,0,8" ToolTip="Формат файла снимка"/>
        <c:LabeledSlider Label="Качество JPEG" Minimum="50" Maximum="100" DefaultValue="95" Step="1" Format="0" Suffix=""
                         Value="{Binding JpegQuality, Mode=TwoWay}"
                         Visibility="{Binding IsJpeg, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8"/>
        <Grid Style="{StaticResource Row}" Visibility="{Binding IsTiff, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Сжатие LZW (без потерь)" Style="{StaticResource Label}"/>
            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding TiffLzw}"/>
        </Grid>

        <!-- Папка и имя -->
        <TextBlock Text="Папка" Style="{StaticResource Section}"/>
        <ui:TextBox Text="{Binding Folder, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding Folder}" ClearButtonEnabled="False" Margin="0,0,0,6"/>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:Button Content="Обзор…" Icon="{ui:SymbolIcon FolderOpen24}" HorizontalAlignment="Stretch" Command="{Binding BrowseCommand}"/>
            <ui:Button Grid.Column="2" Content="Открыть папку" Icon="{ui:SymbolIcon Open24}" HorizontalAlignment="Stretch" Command="{Binding OpenFolderCommand}"/>
        </Grid>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Префикс" Style="{StaticResource Label}" Margin="0,0,10,0"/>
            <ui:TextBox Grid.Column="1" Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged, Delay=400}" ClearButtonEnabled="False"
                        ToolTip="Имя файла: префикс_дата_время_объектив"/>
        </Grid>

        <!-- Переключатели -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Впечатывать оверлеи" Style="{StaticResource Label}" ToolTip="Плашка масштаба, линии измерений, сетка"/>
            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding BurnOverlays}"/>
        </Grid>
        <Grid Style="{StaticResource Row}" IsEnabled="{Binding BurnOverlays}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Сохранять также без оверлеев" Style="{StaticResource Label}" ToolTip="Дополнительная копия с суффиксом _clean"/>
            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AlsoSaveClean}"/>
        </Grid>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Метаданные .json" Style="{StaticResource Label}" ToolTip="Время, экспозиция, усиление, коррекция, объектив, мкм/пиксель"/>
            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding WriteMetadata}"/>
        </Grid>

        <!-- Тайм-лапс -->
        <Border CornerRadius="10" Padding="10,8" Margin="0,4,0,0" Background="#10FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Timer24" Foreground="#06B6D4" FontSize="16" Margin="0,0,6,0"/>
                    <TextBlock Grid.Column="1" Text="Тайм-лапс" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                </Grid>
                <Grid Style="{StaticResource Row}" IsEnabled="{Binding IsRunning, Converter={StaticResource Equals}, ConverterParameter=False}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Интервал, с" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,3"/>
                        <ui:NumberBox Value="{Binding IntervalSeconds, UpdateSourceTrigger=LostFocus}" Minimum="0.5" Maximum="86400"
                                      SmallChange="0.5" LargeChange="10" MaxDecimalPlaces="1" ClearButtonEnabled="False"
                                      ToolTip="Пауза между кадрами, не меньше 0.5 с"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Кадров (0 — ∞)" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,3"/>
                        <ui:NumberBox Value="{Binding Count, UpdateSourceTrigger=LostFocus}" Minimum="0" Maximum="1000000"
                                      SmallChange="1" LargeChange="10" MaxDecimalPlaces="0" ClearButtonEnabled="False"
                                      ToolTip="Сколько кадров снять; 0 — пока не остановите"/>
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" Foreground="#06B6D4" FontSize="14"/>
                        <TextBlock Text="{Binding NextShotText}" Style="{StaticResource MutedText}" FontSize="11.5"
                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding ToggleTimelapseCommand}" fx:ClickSpark.IsEnabled="True">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Content" Value="Старт"/>
                                <Setter Property="Icon" Value="{ui:SymbolIcon Play24}"/>
                                <Setter Property="Appearance" Value="Primary"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Content" Value="Стоп"/>
                                        <Setter Property="Icon" Value="{ui:SymbolIcon Stop24}"/>
                                        <Setter Property="Appearance" Value="Danger"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </Grid>
                <ProgressBar Height="3" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}"
                             Foreground="#7C3AED" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- Состояние записи -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
                             Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" FontSize="11.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       Text="{Binding StatusText}" ToolTip="{Binding StatusText}"/>
        </Grid>
    </StackPanel>
</UserControl>
