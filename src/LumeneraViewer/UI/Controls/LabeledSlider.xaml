<UserControl x:Class="LumeneraViewer.UI.Controls.LabeledSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Подпись + число справа + слайдер. Двойной клик — сброс к DefaultValue. -->
    <Grid Margin="0,0,0,4" Background="Transparent" PreviewMouseLeftButtonDown="OnPreviewDown"
          ToolTip="Двойной клик — сбросить">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label, ElementName=Root}" FontSize="12.5" Foreground="{StaticResource Zs.Text}" VerticalAlignment="Center"/>
        <TextBlock x:Name="ValueLabel" Grid.Column="1" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Zs.TextSecondary}"
                   VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"/>
        <Slider x:Name="PART_Slider" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,0"
                Minimum="{Binding Minimum, ElementName=Root}"
                Maximum="{Binding Maximum, ElementName=Root}"
                SmallChange="{Binding Step, ElementName=Root}"
                LargeChange="{Binding Step, ElementName=Root}"
                TickFrequency="{Binding Step, ElementName=Root}"
                IsSnapToTickEnabled="True"
                IsMoveToPointEnabled="True"
                Value="{Binding Value, ElementName=Root, Mode=TwoWay}"/>
    </Grid>
</UserControl>
