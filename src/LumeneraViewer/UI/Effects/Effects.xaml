<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:fx="clr-namespace:LumeneraViewer.UI.Effects"
                    xmlns:c="clr-namespace:LumeneraViewer.UI.Controls">

    <Style TargetType="{x:Type fx:GlowButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type fx:GlowButton}">
                    <Border x:Name="PART_Surface" CornerRadius="12" SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7C3AED" Offset="0"/>
                                <GradientStop Color="#06B6D4" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Border CornerRadius="12,12,0,0" VerticalAlignment="Top" Height="18">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#33FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="12" BorderThickness="1" BorderBrush="#40FFFFFF"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Панель статуса в шапке: одно стекло, как у SpotlightCard, разделённое на сегменты -->
    <Style x:Key="StatusPanel" TargetType="Border">
        <Setter Property="Background" Value="#14FFFFFF"/>
        <Setter Property="BorderBrush" Value="#22FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Вертикальный разделитель сегментов -->
    <Style x:Key="StatusDivider" TargetType="Rectangle">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Fill" Value="#1FFFFFFF"/>
        <Setter Property="Margin" Value="0,11"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Значение сегмента -->
    <Style x:Key="StatusValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#F2FFFFFF"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Маленький прямоугольный тег (ДЕМО) -->
    <Style x:Key="StatusTag" TargetType="Border">
        <Setter Property="Background" Value="#407C3AED"/>
        <Setter Property="BorderBrush" Value="#997C3AED"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="5,1,5,1"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="{x:Type c:StatusSegment}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="14,0,16,0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:StatusSegment}">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                <ui:SymbolIcon x:Name="PART_Icon" Symbol="{TemplateBinding Icon}" FontSize="16"
                                               Foreground="#8CFFFFFF" Visibility="Collapsed"/>
                                <ContentPresenter x:Name="PART_Indicator" Content="{TemplateBinding Indicator}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding CaptionText}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#73FFFFFF" Margin="0,0,0,2"/>
                                <Grid>
                                    <ContentPresenter x:Name="PART_Value"/>
                                    <TextBlock x:Name="PART_Empty" Text="—" Style="{StaticResource StatusValue}" Visibility="Collapsed"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEmpty" Value="True">
                            <Setter TargetName="PART_Value" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_Empty" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Indicator" Value="{x:Null}">
                            <Setter TargetName="PART_Icon" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#99FFFFFF"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
</ResourceDictionary>
