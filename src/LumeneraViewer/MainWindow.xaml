<ui:FluentWindow x:Class="LumeneraViewer.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:fx="clr-namespace:LumeneraViewer.UI.Effects"
                 xmlns:c="clr-namespace:LumeneraViewer.UI.Controls"
                 xmlns:v="clr-namespace:LumeneraViewer.Views"
                 Title="Lumenera Studio"
                 Width="1400" Height="880" MinWidth="960" MinHeight="600"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 Background="#0B0B12"
                 Foreground="White">
    <Grid>
        <fx:AuroraBackground/>

        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок окна -->
            <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Height="44">
                <ui:TitleBar.Header>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="7" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#06B6D4" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ui:SymbolIcon Symbol="Microscope24" FontSize="13" Foreground="White"/>
                        </Border>
                        <fx:ShinyText Text="Lumenera Studio" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="  ·  INFINITY 4" Foreground="#80FFFFFF" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:TitleBar.Header>
            </ui:TitleBar>

            <!-- Шапка: статус и действия -->
            <Grid x:Name="Toolbar" Grid.Row="1" Margin="16,4,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Панель статуса: одно стекло, сегменты через тонкие разделители -->
                <Border Style="{StaticResource StatusPanel}">
                    <StackPanel Orientation="Horizontal">
                        <c:StatusSegment Caption="Статус" MinWidth="218">
                            <c:StatusSegment.Indicator>
                                <Grid Width="10" Height="10">
                                    <Ellipse Fill="{Binding State, Converter={StaticResource StateBrush}}" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="2.6" Duration="0:0:1.4"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="2.6" Duration="0:0:1.4"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:1.4"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <Ellipse Fill="{Binding State, Converter={StaticResource StateBrush}}"/>
                                </Grid>
                            </c:StatusSegment.Indicator>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusValue}"/>
                                <Border Style="{StaticResource StatusTag}" Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="ДЕМО" FontSize="10" FontWeight="Bold" Foreground="#DDD6FE"/>
                                </Border>
                            </StackPanel>
                        </c:StatusSegment>
                        <Rectangle Style="{StaticResource StatusDivider}"/>
                        <c:StatusSegment Caption="Камера" Icon="Camera24" MinWidth="236" MaxWidth="320"
                                         IsEmpty="{Binding IsPlaceholderVisible}">
                            <TextBlock Text="{Binding CameraTitle}" ToolTip="{Binding CameraTitle}" Style="{StaticResource StatusValue}"/>
                        </c:StatusSegment>
                        <Rectangle Style="{StaticResource StatusDivider}"/>
                        <c:StatusSegment Caption="Разрешение" Icon="Resize24" MinWidth="132"
                                         IsEmpty="{Binding IsPlaceholderVisible}">
                            <TextBlock Text="{Binding ResolutionText}" Style="{StaticResource StatusValue}"/>
                        </c:StatusSegment>
                        <Rectangle Style="{StaticResource StatusDivider}"/>
                        <c:StatusSegment Caption="FPS" Icon="TopSpeed24" MinWidth="104"
                                         IsEmpty="{Binding IsPlaceholderVisible}">
                            <StackPanel Orientation="Horizontal">
                                <fx:CountUpText Value="{Binding Fps}" Format="0.0" FontSize="13.5" FontWeight="SemiBold" Foreground="#06B6D4"/>
                                <TextBlock Text=" к/с" FontSize="12" Foreground="#8CFFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                            </StackPanel>
                        </c:StatusSegment>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton IsChecked="{Binding IsFrozen}" ToolTip="Пауза (F)" Margin="0,0,6,0" Padding="12,6" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Pause24" Margin="0,0,6,0"/>
                            <TextBlock Text="Пауза"/>
                        </StackPanel>
                    </ToggleButton>
                    <ui:Button Icon="{ui:SymbolIcon ZoomFit24}" Content="Вписать" ToolTip="Вписать (Ctrl+0, двойной клик)" Click="Fit_Click" Margin="0,0,6,0" Focusable="False"/>
                    <ui:Button Content="1:1" ToolTip="Пиксель в пиксель (Ctrl+1)" Click="ActualPixels_Click" Margin="0,0,6,0" Focusable="False"/>
                    <ui:Button Icon="{ui:SymbolIcon PanelRight24}" ToolTip="Панель (Tab)" Command="{Binding TogglePanelCommand}" Margin="0,0,6,0" Focusable="False"/>
                    <ui:Button x:Name="MoreButton" Icon="{ui:SymbolIcon MoreHorizontal24}" ToolTip="Ещё" Click="More_Click" Focusable="False">
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Дополнительно…" Command="{Binding ShowAdvancedCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Settings24"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Переподключить камеру" Command="{Binding RetryCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowClockwise24"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Демо-режим" Command="{Binding DemoCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Sparkle24"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Установить/переустановить драйверы" Command="{Binding InstallDriversCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowDownload24"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- Рабочая область -->
            <Grid Grid.Row="2" Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Превью -->
                    <Border CornerRadius="14" Background="#CC050509" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <Grid>
                            <c:ZoomPanHost x:Name="Zoom" Margin="1"
                                           Zoom="{Binding PreviewZoom, Mode=OneWayToSource}"
                                           LeftButtonPans="{Binding ActiveTool, Converter={StaticResource Equals}, ConverterParameter=None}"
                                           Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                <Grid Width="{Binding FrameWidth}" Height="{Binding FrameHeight}">
                                    <Image Source="{Binding PreviewBitmap}" Stretch="Fill"/>
                                    <v:PreviewOverlay/>
                                </Grid>
                            </c:ZoomPanHost>

                            <!-- Индикатор зума и пауза -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                <Border Background="#99000000" CornerRadius="8" Padding="10,4" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding PreviewZoom, StringFormat={}{0:P0}}" FontSize="12.5" Foreground="White"/>
                                </Border>
                                <Border Background="#CCF59E0B" CornerRadius="8" Padding="10,4"
                                        Visibility="{Binding IsFrozen, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="ПАУЗА" FontSize="12" FontWeight="Bold" Foreground="Black"/>
                                </Border>
                            </StackPanel>

                            <!-- Экран «нет камеры» -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"
                                        Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BoolToVis}}">
                                <Grid Width="140" Height="140" HorizontalAlignment="Center" Margin="0,0,0,18">
                                    <Ellipse Stroke="#7C3AED" StrokeThickness="2" RenderTransformOrigin="0.5,0.5" Opacity="0">
                                        <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.45" To="1" Duration="0:0:2.4"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.45" To="1" Duration="0:0:2.4"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:2.4"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <Ellipse Stroke="#06B6D4" StrokeThickness="2" RenderTransformOrigin="0.5,0.5" Opacity="0">
                                        <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" BeginTime="0:0:1.2" Timeline.DesiredFrameRate="30">
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.45" To="1" Duration="0:0:2.4"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.45" To="1" Duration="0:0:2.4"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:2.4"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <Border Width="68" Height="68" CornerRadius="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#7C3AED" Offset="0"/>
                                                <GradientStop Color="#06B6D4" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#7C3AED" BlurRadius="30" ShadowDepth="0" Opacity="0.7"/>
                                        </Border.Effect>
                                        <ui:SymbolIcon Symbol="Camera24" FontSize="30" Foreground="White"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding PlaceholderTitle}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White"/>
                                <TextBlock Text="{Binding PlaceholderText}" FontSize="13.5" Foreground="#A6FFFFFF" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,8,0,18"/>
                                <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" Margin="0,0,0,14"
                                                 Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                    <ui:Button Content="Установить драйверы" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary"
                                               Command="{Binding InstallDriversCommand}" Margin="0,0,8,0"
                                               Visibility="{Binding ShowInstallDrivers, Converter={StaticResource BoolToVis}}"/>
                                    <ui:Button Content="Повторить" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RetryCommand}" Margin="0,0,8,0"/>
                                    <ui:Button Content="Демо-режим" Icon="{ui:SymbolIcon Sparkle24}" Appearance="Primary" Command="{Binding DemoCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Лента снимков (таск 06) -->
                    <fx:SpotlightCard Grid.Row="1" Margin="0,12,0,0" Height="96" Padding="16,12" SpotlightColor="#06B6D4">
                        <v:GalleryStrip DataContext="{Binding Gallery}"/>
                    </fx:SpotlightCard>
                </Grid>

                <!-- Правая панель -->
                <Grid Grid.Column="1" Width="344" Margin="14,0,0,0"
                      Visibility="{Binding IsPanelCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,4,0">
                        <StackPanel x:Name="Cards">
                            <fx:SpotlightCard Margin="0,0,0,10">
                                <StackPanel>
                                    <c:CardHeader Title="Камера" Icon="Camera24"/>
                                    <v:CameraPanel DataContext="{Binding CameraPanel}"/>
                                </StackPanel>
                            </fx:SpotlightCard>
                            <fx:SpotlightCard Margin="0,0,0,10" SpotlightColor="#F472B6">
                                <StackPanel>
                                    <c:CardHeader Title="Цвет" Icon="Color24"/>
                                    <v:ColorPanel DataContext="{Binding ColorPanel}"/>
                                </StackPanel>
                            </fx:SpotlightCard>
                            <fx:SpotlightCard Margin="0,0,0,10" SpotlightColor="#06B6D4">
                                <StackPanel>
                                    <c:CardHeader Title="Масштаб" Icon="Scales24"/>
                                    <v:ScalePanel DataContext="{Binding ScalePanel}"/>
                                </StackPanel>
                            </fx:SpotlightCard>
                            <fx:SpotlightCard Margin="0,0,0,10">
                                <StackPanel>
                                    <c:CardHeader Title="Измерения" Icon="Ruler24"/>
                                    <v:MeasurePanel DataContext="{Binding MeasurePanel}"/>
                                </StackPanel>
                            </fx:SpotlightCard>
                            <fx:SpotlightCard Margin="0,0,0,10" SpotlightColor="#F472B6">
                                <StackPanel>
                                    <c:CardHeader Title="Сохранение" Icon="Save24"/>
                                    <v:CapturePanel DataContext="{Binding CapturePanel}"/>
                                </StackPanel>
                            </fx:SpotlightCard>
                        </StackPanel>
                    </ScrollViewer>
                    <fx:GlowButton Grid.Row="1" Margin="0,12,0,0" Command="{Binding CapturePanel.CaptureCommand}" ToolTip="Снимок (Пробел)">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Camera24" Filled="True" FontSize="18" Foreground="White" Margin="0,0,8,0"/>
                            <TextBlock Text="Снимок" VerticalAlignment="Center"/>
                            <Border Background="#33FFFFFF" CornerRadius="6" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Пробел" FontSize="11" FontWeight="Normal"/>
                            </Border>
                        </StackPanel>
                    </fx:GlowButton>
                </Grid>
            </Grid>
        </Grid>

        <ui:SnackbarPresenter x:Name="SnackbarPresenter" VerticalAlignment="Bottom" Margin="0,0,0,24"/>
        <ui:ContentDialogHost/>
    </Grid>
</ui:FluentWindow>
