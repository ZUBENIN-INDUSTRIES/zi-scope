<Window x:Class="LumeneraViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumenera INFINITY 4 — Viewer"
        Height="720" Width="1100"
        Background="#1e1e1e">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Black" BorderBrush="#444" BorderThickness="1">
            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
            <Button x:Name="ShotButton" Content="Shot" Width="90" Height="34" FontSize="14" FontWeight="Bold"
                    Click="ShotButton_Click"/>

            <TextBlock Text="Формат:" Foreground="White" VerticalAlignment="Center" Margin="16,0,4,0"/>
            <ComboBox x:Name="FormatComboBox" Width="90" SelectedIndex="0">
                <ComboBoxItem Content="PNG" Tag="png"/>
                <ComboBoxItem Content="JPEG" Tag="jpg"/>
                <ComboBoxItem Content="TIFF" Tag="tif"/>
                <ComboBoxItem Content="BMP" Tag="bmp"/>
            </ComboBox>

            <TextBlock Text="Папка:" Foreground="White" VerticalAlignment="Center" Margin="16,0,4,0"/>
            <TextBox x:Name="OutputFolderTextBox" Width="380" VerticalContentAlignment="Center"/>
            <Button x:Name="BrowseButton" Content="Обзор..." Width="80" Margin="6,0,0,0" Click="BrowseButton_Click"/>
            <Button x:Name="OpenFolderButton" Content="Открыть папку" Width="110" Margin="6,0,0,0" Click="OpenFolderButton_Click"/>

            <Button x:Name="ReconnectButton" Content="Переподключить" Width="130" Margin="16,0,0,0" Click="ReconnectButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#cccccc" Margin="0,6,0,0" Text="Подключение к камере..."/>
    </Grid>
</Window>
