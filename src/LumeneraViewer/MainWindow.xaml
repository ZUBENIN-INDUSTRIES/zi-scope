<ui:FluentWindow x:Class="LumeneraViewer.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:fx="clr-namespace:LumeneraViewer.UI.Effects"
                 xmlns:c="clr-namespace:LumeneraViewer.UI.Controls"
                 xmlns:v="clr-namespace:LumeneraViewer.Views"
                 Title="ZI-scope"
                 Width="1400" Height="880" MinWidth="960" MinHeight="600"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 Background="{StaticResource Zs.Window}"
                 Foreground="{StaticResource Zs.Text}"
                 FontFamily="{StaticResource Zs.Font}"
                 FontSize="13">
    <!-- Фон — на корне: FluentWindow без подложки иначе показывает системный #202020 -->
    <Grid Background="{StaticResource Zs.Window}">
        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок окна -->
            <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Height="40">
                <ui:TitleBar.Header>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Microscope24" FontSize="16" Foreground="{StaticResource Zs.TextSecondary}" Margin="0,0,8,0"/>
                        <TextBlock Text="ZI-scope" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:TitleBar.Header>
            </ui:TitleBar>

            <!-- Шапка: статус, увеличение, действия -->
            <Grid x:Name="Toolbar" Grid.Row="1" Margin="12,0,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Панель статуса: сегменты через тонкие разделители -->
                <Border Style="{StaticResource StatusPanel}">
                    <StackPanel Orientation="Horizontal">
                        <c:StatusSegment Caption="Статус" MinWidth="200">
                            <c:StatusSegment.Indicator>
                                <Ellipse Width="8" Height="8" Fill="{Binding State, Converter={StaticResource StateBrush}}"/>
                            </c:StatusSegment.Indicator>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusValue}"/>
                                <Border Style="{StaticResource StatusTag}" Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="ДЕМО" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Zs.TextSecondary}"/>
                                </Border>
                            </StackPanel>
                        </c:StatusSegment>
                        <Rectangle Style="{StaticResource StatusDivider}"/>
                        <c:StatusSegment Caption="Камера" Icon="Camera24" MinWidth="220" MaxWidth="300"
                                         IsEmpty="{Binding IsPlaceholderVisible}">
                            <TextBlock Text="{Binding CameraTitle}" ToolTip="{Binding CameraTitle}" Style="{StaticResource StatusValue}"/>
                        </c:StatusSegment>
                        <Rectangle Style="{StaticResource StatusDivider}"/>
                        <c:StatusSegment Caption="Разрешение" Icon="Resize24" MinWidth="124"
                                         IsEmpty="{Binding IsPlaceholderVisible}">
                            <TextBlock Text="{Binding ResolutionText}" Style="{StaticResource StatusValue}"/>
                        </c:StatusSegment>
                        <Rectangle Style="{StaticResource StatusDivider}"/>
                        <c:StatusSegment Caption="FPS" Icon="TopSpeed24" MinWidth="98"
                                         IsEmpty="{Binding IsPlaceholderVisible}">
                            <StackPanel Orientation="Horizontal">
                                <fx:CountUpText Value="{Binding Fps}" Format="0.0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Zs.Text}"/>
                                <TextBlock Text=" к/с" FontSize="12" Foreground="{StaticResource Zs.TextSecondary}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                            </StackPanel>
                        </c:StatusSegment>
                    </StackPanel>
                </Border>

                <!-- Слот: переключатель увеличений (таск 04) -->
                <v:MagnificationBar x:Name="MagnificationSlot" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                    HorizontalAlignment="Left"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton IsChecked="{Binding IsFrozen}" ToolTip="Пауза (F)" Margin="0,0,6,0" Padding="10,5" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Pause24" FontSize="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Пауза"/>
                        </StackPanel>
                    </ToggleButton>
                    <ui:Button Icon="{ui:SymbolIcon ZoomFit24}" Content="Вписать" ToolTip="Вписать (Ctrl+0, двойной клик)" Click="Fit_Click" Margin="0,0,6,0" Focusable="False"/>
                    <ui:Button Content="1:1" ToolTip="Пиксель в пиксель (Ctrl+1)" Click="ActualPixels_Click" Margin="0,0,6,0" Focusable="False"/>
                    <ui:Button Icon="{ui:SymbolIcon PanelLeft24}" ToolTip="Панель (Tab)" Command="{Binding TogglePanelCommand}" Margin="0,0,6,0" Focusable="False"/>
                    <!-- Уведомления: журнал в отдельном окне, здесь только значок с числом непрочитанных -->
                    <ui:Button ToolTip="Уведомления" AutomationProperties.Name="Уведомления" Command="{Binding ShowNotificationsCommand}" Margin="0,0,6,0" Padding="9,5" Focusable="False">
                        <Grid>
                            <ui:SymbolIcon Symbol="Alert24" FontSize="16"/>
                            <Border Visibility="{Binding Notifications.HasUnread, Converter={StaticResource BoolToVis}}"
                                    MinWidth="15" Height="15" fx:Pill.IsPill="True" Padding="3,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-9,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Zs.Accent}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Notifications.UnreadSeverity}" Value="Warning">
                                                <Setter Property="Background" Value="{StaticResource Zs.Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Notifications.UnreadSeverity}" Value="Error">
                                                <Setter Property="Background" Value="{StaticResource Zs.Error}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Notifications.UnreadCount}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource Zs.Window}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </ui:Button>
                    <ui:Button x:Name="MoreButton" Icon="{ui:SymbolIcon MoreHorizontal24}" ToolTip="Ещё" Click="More_Click" Focusable="False">
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Дополнительно…" Command="{Binding ShowAdvancedCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Settings24"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Глубокие настройки цвета…" Command="{x:Static v:DeepColorWindow.OpenCommand}" CommandParameter="{Binding}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="ColorLine24"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Уведомления…" Command="{Binding ShowNotificationsCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Alert24"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Профили конфигурации…" Command="{Binding ShowConfigProfilesCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="DocumentSettings20"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Переподключить камеру" Command="{Binding RetryCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowClockwise24"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Демо-режим" Command="{Binding DemoCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Sparkle24"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Установить/переустановить драйверы" Command="{Binding InstallDriversCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowDownload24"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- Рабочая область -->
            <Grid Grid.Row="2" Margin="12,0,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Превью -->
                    <Border CornerRadius="{StaticResource Zs.RadiusPanel}" Background="{StaticResource Zs.Input}">
                        <Grid>
                            <c:ZoomPanHost x:Name="Zoom" Margin="1"
                                           Zoom="{Binding PreviewZoom, Mode=OneWayToSource}"
                                           LeftButtonPans="{Binding ActiveTool, Converter={StaticResource Equals}, ConverterParameter=None}"
                                           Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                <Grid Width="{Binding FrameWidth}" Height="{Binding FrameHeight}">
                                    <Image Source="{Binding PreviewBitmap}" Stretch="Fill"/>
                                    <v:PreviewOverlay/>
                                </Grid>
                            </c:ZoomPanHost>

                            <!-- Индикатор зума и пауза -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                <Border Background="{StaticResource Zs.Scrim}" fx:Pill.IsPill="True" Padding="10,3" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding PreviewZoom, StringFormat={}{0:P0}}" FontSize="12" Foreground="{StaticResource Zs.Text}"/>
                                </Border>
                                <Border Background="{StaticResource Zs.Warning}" fx:Pill.IsPill="True" Padding="10,3"
                                        Visibility="{Binding IsFrozen, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="ПАУЗА" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Zs.Window}"/>
                                </Border>
                            </StackPanel>

                            <!-- Серия: просьба переключить микроскоп — неброская плашка поверх превью -->
                            <Border DataContext="{Binding SeriesPanel}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,12,16,0"
                                    Background="{StaticResource Zs.Scrim}" BorderBrush="{StaticResource Zs.Border}" BorderThickness="1"
                                    fx:Pill.IsPill="True" Padding="14,6" IsHitTestVisible="False"
                                    Visibility="{Binding HasPrompt, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Microscope24" FontSize="16" Foreground="{StaticResource Zs.Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PromptText}" FontSize="12.5" Foreground="{StaticResource Zs.Text}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Экран «нет камеры» -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"
                                        Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BoolToVis}}">
                                <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,16"
                                        Background="{StaticResource Zs.Raised}" BorderBrush="{StaticResource Zs.Border}" BorderThickness="1">
                                    <ui:SymbolIcon Symbol="Camera24" FontSize="24" Foreground="{StaticResource Zs.TextSecondary}"/>
                                </Border>
                                <TextBlock Text="{Binding PlaceholderTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding PlaceholderText}" FontSize="13" Foreground="{StaticResource Zs.TextSecondary}" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,6,0,18"/>
                                <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" Margin="0,0,0,14"
                                                 Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                    <ui:Button Content="Установить драйверы" Icon="{ui:SymbolIcon ArrowDownload24}"
                                               Command="{Binding InstallDriversCommand}" Margin="0,0,8,0"
                                               Visibility="{Binding ShowInstallDrivers, Converter={StaticResource BoolToVis}}"/>
                                    <ui:Button Content="Повторить" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RetryCommand}" Margin="0,0,8,0"/>
                                    <ui:Button Content="Демо-режим" Icon="{ui:SymbolIcon Sparkle24}" Command="{Binding DemoCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Низ: лента снимков или карта серии -->
                    <Border Grid.Row="1" Margin="0,10,0,0" Height="122" Style="{StaticResource ZsPanel}" Padding="12,8,12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource ZsSegmentBar}" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="BottomGallery" Style="{StaticResource ZsSegment}" GroupName="Bottom" IsChecked="True" Content="Лента"/>
                                    <RadioButton x:Name="BottomSeries" Style="{StaticResource ZsSegment}" GroupName="Bottom" Content="Карта серии"/>
                                </StackPanel>
                            </Border>
                            <v:GalleryStrip Grid.Row="1" DataContext="{Binding Gallery}"
                                            Visibility="{Binding IsChecked, ElementName=BottomGallery, Converter={StaticResource BoolToVis}}"/>
                            <v:SeriesMap Grid.Row="1" DataContext="{Binding SeriesPanel}"
                                         Visibility="{Binding IsChecked, ElementName=BottomSeries, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Левая панель (G07): полоса вкладок-иконок (как activity bar) + содержимое вкладки -->
                <Border Grid.Column="0" Margin="0,0,10,0" Style="{StaticResource ZsPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="2" Width="320"
                              Visibility="{Binding IsPanelCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="TabTitle" Text="Камера" Margin="16,14,16,0" FontSize="13" FontWeight="SemiBold"/>

                            <ScrollViewer x:Name="TabScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="16,0,12,12">
                                <Grid x:Name="Pages">
                                    <StackPanel x:Name="PageCamera" Tag="camera">
                                        <v:CameraPanel Margin="0,12,0,0" DataContext="{Binding CameraPanel}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="PageColor" Tag="color" Visibility="Collapsed">
                                        <v:ColorPanel Margin="0,12,0,0" DataContext="{Binding ColorPanel}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="PageScale" Tag="scale" Visibility="Collapsed">
                                        <v:ScalePanel DataContext="{Binding ScalePanel}"/>
                                        <Border Style="{StaticResource ZsDivider}" Margin="0,14,0,14"/>
                                        <c:CardHeader Title="Измерения" Icon="Ruler24" Margin="0"/>
                                        <v:MeasurePanel DataContext="{Binding MeasurePanel}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="PageSeries" Tag="series" Visibility="Collapsed">
                                        <v:SeriesPanel DataContext="{Binding SeriesPanel}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="PageCapture" Tag="capture" Visibility="Collapsed">
                                        <v:CapturePanel DataContext="{Binding CapturePanel}"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>

                            <Border Grid.Row="2" BorderBrush="{StaticResource Zs.Border}" BorderThickness="0,1,0,0" Padding="12">
                                <Button Command="{Binding PrimaryCaptureCommand}" AutomationProperties.Name="Главный снимок">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ZsPrimaryButton}">
                                            <Setter Property="ToolTip" Value="Снимок (Пробел)"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SeriesPanel.IsActive}" Value="True">
                                                    <Setter Property="ToolTip" Value="Снять шаг серии (Пробел)"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Camera24" Filled="True" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Снимок"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SeriesPanel.IsActive}" Value="True">
                                                            <Setter Property="Text" Value="{Binding SeriesPanel.CaptureButtonText}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Style="{StaticResource ZsKeyHint}">
                                            <TextBlock Text="Пробел" FontSize="11" FontWeight="Normal"/>
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </Grid>

                        <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Zs.Border}"
                                   Visibility="{Binding IsPanelCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

                        <StackPanel x:Name="TabBar" Grid.Column="0" Width="48" Margin="0,6,0,6">
                            <RadioButton Style="{StaticResource ZsActivityTab}" GroupName="Tabs" Tag="camera" ToolTip="Камера" AutomationProperties.Name="Камера"
                                         Checked="Tab_Checked" PreviewMouseLeftButtonDown="Tab_PreviewDown">
                                <ui:SymbolIcon Symbol="Camera24" FontSize="20"/>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ZsActivityTab}" GroupName="Tabs" Tag="color" ToolTip="Цвет" AutomationProperties.Name="Цвет"
                                         Checked="Tab_Checked" PreviewMouseLeftButtonDown="Tab_PreviewDown">
                                <ui:SymbolIcon Symbol="ColorLine24" FontSize="20"/>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ZsActivityTab}" GroupName="Tabs" Tag="scale" ToolTip="Масштаб и измерения" AutomationProperties.Name="Масштаб и измерения"
                                         Checked="Tab_Checked" PreviewMouseLeftButtonDown="Tab_PreviewDown">
                                <ui:SymbolIcon Symbol="Ruler24" FontSize="20"/>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ZsActivityTab}" GroupName="Tabs" Tag="series" ToolTip="Серия" AutomationProperties.Name="Серия"
                                         Checked="Tab_Checked" PreviewMouseLeftButtonDown="Tab_PreviewDown">
                                <ui:SymbolIcon Symbol="TableSimple24" FontSize="20"/>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ZsActivityTab}" GroupName="Tabs" Tag="capture" ToolTip="Сохранение" AutomationProperties.Name="Сохранение"
                                         Checked="Tab_Checked" PreviewMouseLeftButtonDown="Tab_PreviewDown">
                                <ui:SymbolIcon Symbol="Save24" FontSize="20"/>
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <ui:ContentDialogHost/>
    </Grid>
</ui:FluentWindow>
